      "name": "Heartbeat Campaign",
      "year_published": "2013",
      "description": "Trend Micro documented a campaign running from 2009 to 2012 targeting South Korean political parties, government agencies, a military branch, media, and a national policy research institute. Attackers used Hangul Word Processor (HWP) decoy documents and early Bisonal variants. This was the first public reporting on the activity cluster later identified as Tonto Team.\n",
      "target_sectors": [
        "government",
        "military",
        "media",
        "research"
      ],
      "target_regions": [
        "South Korea"
      ],
      "sources": [
