        }
      ]
    },
    {
      "name": "Group-IB Targeting",
      "year_published": "2023",
      "description": "Group-IB disclosed two attempted attacks on its employees in March 2021 and June 2022, both detected and blocked. The attacks used spear-phishing with Royal Road RTF documents to deliver the Bisonal.DoubleT backdoor and a previously undocumented downloader called QuickMute. Group-IB assessed the targeting reflected Tonto Team's interest in IT and cybersecurity firms as potential supply chain entry points.\n",
      "target_sectors": [
        "technology"
      ],
      "target_regions": [
        "Singapore",
        "Russia"
      ],
      "sources": [
        {
          "url": "https://www.group-ib.com/blog/tonto-team/",
          "title": "Nice Try Tonto Team",
          "publisher": "Group-IB"
        }
      ]
    },
    {
      "name": "South Korean Institutions (CHM/Anti-Malware Abuse)",
      "year_published": "2023",
      "description": "AhnLab ASEC documented attacks against South Korean education, construction, diplomatic, and political institutions. The group used CHM files to side-load a malicious DLL via a legitimate anti-malware product file, deploying ReVBShell. The infection chain matched the TAG-74 pattern documented by Recorded Future.\n",
      "target_sectors": [
        "education",
        "construction",
        "diplomatic",
        "government"
      ],
      "target_regions": [
        "South Korea"
      ],
      "sources": [
