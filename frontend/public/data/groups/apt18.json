  "affiliation": [
    "PLA"
  ],
  "affiliation_unit": null,
  "affiliation_detail": "Some sources attribute APT18 to the Chinese People's Liberation Army Navy (PLAN/PLA Navy). Bugcrowd states \"security researchers generally agree that APT18 is directly supported by, and aligned with, the Chinese People's Liberation Navy.\" No attribution details or reports have hoverwer been observed.\nNo DOJ indictment, formal government attribution statement, or specific PLA Navy unit designation has been published. The basis for the PLA Navy attribution has not been detailed in publicly available primary vendor reports.\n",
  "affiliation_confidence": "suspected",
  "entity_name": null,
  "last_seen": "2016",
  "first_seen": "2009",
  "first_described": "2014",
  "description": "APT18 is a Chinese state-sponsored cyber espionage group attributed by some to the People's Liberation Army Navy (PLA Navy), active since at least 2009. \nThe group primarily targets U.S.-based organizations across a wide range of sectors including healthcare, aerospace, defense, telecommunications, high technology, and human rights groups. \nAPT18 is best known for the 2014 Community Health Systems breach, in which the personal information of 4.5 million patients was stolen.\nThe group is notable for its rapid exploitation of newly disclosed vulnerabilities, particularly demonstrated when it weaponized the HackingTeam-leaked Flash zero-day (CVE-2015-5119) within days of disclosure, launching phishing campaigns across numerous industry sectors before a patch was available. (FireEye, 2015) \n",
  "attack_group_id": "G0026",
  "attack_group_url": "https://attack.mitre.org/groups/G0026/",
