  "campaigns": [
    {
      "name": "South China Sea Espionage Campaign",
      "year_published": "2015",
      "description": "Kaspersky documented in May 2015 Naikon's long-running espionage campaigns targeting government agencies, law enforcement, military, and intelligence organizations across Southeast Asia. The group used spear-phishing with regionalized lures tied to geopolitical events (ASEAN summits, South China Sea disputes) to deliver XsFunction RAT and related malware. ThreatConnect/DGI's CameraShy report showed the group used regionalized infrastructure with campaign identifiers referencing specific targets (UNDP, ASEAN, individual countries).\n",
      "target_sectors": [
        "government",
        "military",
        "diplomatic"
      ],
